# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Copie este archivo a .env y defina las IPs y contraseñas antes de desplegar:
#   cp .env.example .env
# ==============================================================================

# --- 1. IPs de las Máquinas Virtuales ---
POSTGRES_HOST=
MONGO_HOST=

# --- 2. PostgreSQL 16 (Administrador del Contenedor y Flyway) ---
POSTGRES_PORT=5432
POSTGRES_DB=ejemplo123
POSTGRES_USER=ejemplo123
POSTGRES_PASSWORD=<CAMBIAR_CLAVE_ADMIN_POSTGRES>

# --- 3. PostgreSQL 16 (Roles Operativos de Menor Privilegio - Flyway Placeholders) ---
APP_DB_USER=ejemplo123
APP_DB_PASSWORD=<CAMBIAR_CLAVE_APP_RESERVAS>
REPORTES_DB_PASSWORD=<CAMBIAR_CLAVE_REPORTES_RESERVAS>

# --- 4. MongoDB 7.0 (Contenedor NoSQL) ---
MONGO_PORT=27017
MONGO_DB=ejemplo123
MONGO_USER=ejemplo123
MONGO_PASSWORD=<CAMBIAR_CLAVE_MONGO>

# --- 5. Clave de Acceso para el Panel de Staff ---
STAFF_ACCESS_KEY=<CAMBIAR_CLAVE_ACCESO_STAFF>
