# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Copie este archivo a .env y defina valores seguros antes de desplegar:
#   cp .env.example .env
# ==============================================================================

# --- PostgreSQL  ---
POSTGRES_HOST=192.168.80.27
POSTGRES_PORT=5432
POSTGRES_DB=reservas_db
POSTGRES_USER=reservas_admin
POSTGRES_PASSWORD=<CAMBIAR_CLAVE_ADMIN_POSTGRES>

# --- PostgreSQL (Rol Operativo de Aplicación - Menor Privilegio) ---
APP_DB_USER=app_reservas
APP_DB_PASSWORD=<CAMBIAR_CLAVE_APP_RESERVAS>

# --- MongoDB ---
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=reservas_eventos_docs
MONGO_USER=admin
MONGO_PASSWORD=<CAMBIAR_CLAVE_MONGO>
MONGO_URI=mongodb://admin:<CAMBIAR_CLAVE_MONGO>@localhost:27017/reservas_eventos_docs?authSource=admin&connectTimeoutMS=3000&serverSelectionTimeoutMS=3000

# --- Seguridad de la Aplicación ---
STAFF_ACCESS_KEY=<CAMBIAR_CLAVE_ACCESO_STAFF>

